<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:FaultWitness.App.Presentation" x:Class="FaultWitness.App.Views.Pages.CaptureConfirmationWindow" x:DataType="p:CaptureConfirmationPresentation" Width="500" Height="300" CanResize="False" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.primary-action">
      <Setter Property="MinHeight" Value="{DynamicResource component.action.primary.minHeight}"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto" Margin="{DynamicResource UiSurfacePadding}" RowSpacing="{DynamicResource primitive.space.4}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <TextBlock Text="{Binding Warning}"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="1">
      <Button Name="CaptureConfirmButton" Click="Confirm" AutomationProperties.Name="{Binding ConfirmLabel}" Margin="{DynamicResource UiCommandMargin}">
        <TextBlock Text="{Binding ConfirmLabel}"/>
      </Button>
      <Button Name="CaptureCancelButton" Classes="secondary-action" Click="Cancel" AutomationProperties.Name="{Binding Text[Cancel]}">
        <TextBlock Text="{Binding Text[Cancel]}"/>
      </Button>
    </WrapPanel>
  </Grid>
</Window>
