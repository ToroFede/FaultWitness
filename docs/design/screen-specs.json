{
  "version": "1.0.1",
  "breakpoints": {
    "small": {
      "max": 640
    },
    "medium": {
      "min": 641,
      "max": 1007
    },
    "large": {
      "min": 1008
    }
  },
  "screens": [
    {
      "id": "Home",
      "userGoal": "understand purpose and next action",
      "primaryQuestion": "What should I do now and what did the last analysis show?",
      "primaryAction": "Analyze selected recent period",
      "secondaryActions": [
        "Analyze crash or freeze",
        "Analyze diagnostic files",
        "Open history"
      ],
      "informationPriority": [
        "purpose",
        "primary action",
        "last result",
        "recent significant incidents",
        "coverage"
      ],
      "regions": [
        "intro",
        "commandArea",
        "lastAnalysis",
        "recentIncidents"
      ],
      "defaultFocus": "primaryAction",
      "emptyState": "explain local analysis and privacy",
      "loadingState": "inline progress with cancellation",
      "errorState": "friendly status with technical disclosure",
      "responsiveRules": {
        "small": "single column; intrinsic compact navigation 160–208 epx; brand no wrap, ellipsis only if text scaling exceeds available width; stacked summary counts; 12 epx gutter",
        "medium": "compact summary strip with natural wrapping; 24 epx gutter",
        "large": "constrained 1120 epx content; compact summary strip"
      },
      "keyboardFlow": [
        "navigation",
        "primaryAction",
        "secondaryActions",
        "lastAnalysis",
        "recentIncidents"
      ],
      "allowedComponents": [
        "PrimaryAction",
        "SubtleAction",
        "SummaryMetric",
        "IncidentRow",
        "EmptyState",
        "InlineStatus"
      ],
      "forbiddenPatterns": [
        "health score",
        "three equal KPI cards",
        "multiple primary actions"
      ]
    },
    {
      "id": "Analyze",
      "userGoal": "choose a diagnostic workflow",
